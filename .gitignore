# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
apps/api/.env
web/.env

# Python runtime, virtualenvs, and caches
__pycache__/
*.py[cod]
*$py.class
.pycache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/
apps/api/.venv/

# Node, Vite, and frontend build artifacts
node_modules/
web/node_modules/
dist/
web/dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local SQLite databases and transient DB files
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Runtime storage and generated agent artifacts
storage/documents/*
storage/evidence/*
storage/agent-artifacts/*
!storage/documents/.gitkeep
!storage/evidence/.gitkeep
!storage/agent-artifacts/.gitkeep

# Logs and local process files
logs/
*.log
*.pid
*.seed

# Test and tool output
.nyc_output/
playwright-report/
test-results/
